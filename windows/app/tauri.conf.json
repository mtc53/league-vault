{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "League Vault",
  "version": "0.1.0",
  "identifier": "cc.myprojects.leaguevault",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "League Vault",
        "width": 1280,
        "height": 860,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://raw.communitydragon.org https://ddragon.leagueoflegends.com data:; connect-src 'self' https://raw.communitydragon.org; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {}
}
